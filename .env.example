# ============================================================
# SLINGSHOT v22.1 APEX SOVEREIGN — Environment Template (.env)
# ============================================================

# 🌐 URLS FRONTEND -> BACKEND
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_WS_URL=ws://localhost:8000

# 📡 BINANCE API (Lectura de Market Data / Ticks sin latencia)
# ⚠️ Solo permisos de lectura (Read-Only). No habilitar retiros ni trading spot/futures.
BINANCE_API_KEY=tu_binance_api_key_aqui
BINANCE_API_SECRET=tu_binance_api_secret_aqui

# 🔑 BITUNIX API (Ejecución de Futuros & Gestión de Stop Loss en Vivo)
# ⚠️ Permisos requeridos: "Read" + "Futures Trading". Retiros (Withdrawals) PROHIBIDOS.
BITUNIX_API_KEY=tu_bitunix_api_key_aqui
BITUNIX_SECRET_KEY=tu_bitunix_secret_key_aqui

# 🎯 LIVE TRADING TOGGLE
# true = Ejecuta órdenes reales en Bitunix | false = Modo Simulación (Dry-Run)
ENABLE_LIVE_TRADING=true

# 💰 GESTIÓN DE RIESGO INSTITUCIONAL
ACCOUNT_BALANCE=1000.0
MAX_RISK_PCT=0.02
MIN_RR=2.5

# 🎯 RADAR DE ACTIVOS VIGILADOS EN BACKGROUND (14 Activos Institucionales Curados)
RADAR_ASSETS=BTCUSDT,ETHUSDT,SOLUSDT,AVAXUSDT,LINKUSDT,XRPUSDT,PAXGUSDT,RENDERUSDT,SUIUSDT,INJUSDT,NEARUSDT,FETUSDT,ATOMUSDT,TIAUSDT
MAX_WORKERS=14
WORKER_MODE=process

# 📱 TELEGRAM INSTITUTIONAL DISPATCHER (Alertas en Móvil)
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token_aqui
TELEGRAM_CHAT_ID=tu_telegram_chat_id_aqui
ENABLE_TELEGRAM_ALERTS=true

# 🧠 CLOUD AI & LLM ADVISORS (Opcional)
GROQ_API_KEY=tu_groq_api_key_aqui
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# 🧠 OLLAMA LOCAL AI (Opcional - Si tienes Ollama instalado localmente)
OLLAMA_MODEL=gemma3:4b
OLLAMA_URL=http://localhost:11434

# 🔮 SENTIMIENTO DE NOTICIAS
CRYPTOPANIC_API_KEY=tu_cryptopanic_key_aqui
